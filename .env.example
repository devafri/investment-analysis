# Copy this file to .env and fill in your real values.
# .env itself should NEVER be committed -- it's already in .gitignore.

SCHWAB_CLIENT_ID=your_app_key_here
SCHWAB_CLIENT_SECRET=your_secret_here
SCHWAB_REDIRECT_URI=https://127.0.0.1

# Optional: switch market data provider. Defaults to "schwab" if unset.
# MARKET_DATA_PROVIDER=schwab
